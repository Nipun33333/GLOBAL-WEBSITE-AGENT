# Never put real secrets in this file or commit .env.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_ADVANCED_MODEL=gemini-4-argon
GEMINI_FALLBACK_MODELS=
DISCOVERY_API_KEY=
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
SENDER_NAME=
SENDER_EMAIL=
REPLY_TO=
SENDER_POSTAL_ADDRESS=
OWNER_EMAIL=
ENABLE_GENERATION=false
ENABLE_DEPLOYMENT=false
ENABLE_DRAFTS=false
ENABLE_SENDING=false
ENABLE_ROUTINE_REPLIES=false

